FROM mcr.Microsoft.com/dotnet/sdk:10.0 AS build
WORKDiR /src

COPY ["TelemetryCollectorService.Agent.csproj", "./"]
RUN dotnet restore "TelemetryCollectorService.Agent.csproj"

COPY . .
RUN dotnet publish "TelemetryCollectorService.Agent.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.Microsoft.com/dotnet/sdk:10.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "TelemetryCollectorService.Agent.dll"]